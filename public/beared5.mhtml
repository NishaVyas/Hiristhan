  ::file-selector-button { box-sizing: border-box; border: 0px solid; margi=
n: 0px; padding: 0px; }
  html, :host { text-size-adjust: 100%; tab-size: 4; line-height: 1.5; font=
-family: var(--default-font-family,ui-sans-serif, system-ui, sans-serif, "A=
